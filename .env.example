LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# every job has models of its own (writer.ROLES), so one cannot spend the free calls of another
LLM_WRITE=gemini-flash-latest,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash
LLM_READ=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
LLM_SEE=gemini-3.5-flash-lite
LLM_TIMEOUT=150

LANGUAGE=en
TTS=chatterbox
CHATTER_BACKEND=mlx
PREWRITE=1
VOICE=assets/my_voice.wav
EXAGGERATION=0.6
CFG_WEIGHT=0.45
SPEED=1.0
SENTENCE_GAP=0.15
PARAGRAPH_GAP=0.45
VOICE_RATE=-3%

MINUTES=60
SECS_PER_IMAGE=4
HEIGHT=1080
BURN_SUBS=0
CHAPTER_CARDS=0
AI_IMAGES=1
WORDS_PER_IMAGE=40
STYLE=storybook
IMAGE_ENGINE=
SD_STEPS=
SD_SIZE=
CLIPS=1
CLIP_SHARE=3
CLIP_SPEED=0.8
CROSSFADE=0
GRADE=1

PEXELS_API_KEY=
PIXABAY_API_KEY=
CONTACT=you@example.com
MUSIC=assets/music.mp3
MUSIC_VOLUME=0.18

HF_TOKEN=


# sound mix (music, effects, place sounds) and character motion; 0 turns each off
SOUND=1
MOTION=1
# HyperFrames + Remotion effects (fx.py)
FX=1
FX_TITLES=1
FX_CAPTIONS=1

# the dashboard and the job runner never stop to ask about deleting files
ASK_CLEAN=0

# pictures only on the Kaggle GPU; if Kaggle fails the video stops with a message instead of drawing on the Mac
KAGGLE=1
MAC_PICTURES=0

# the strongest Kaggle model plans the whole edit (director.py); the first model that answers is used
DIRECTOR=1
DIRECTOR_MODELS=claude-opus-5-5-default,gpt-6.1-sol,gemini-4-argon
DIRECTOR_TOKENS=16000
KAGGLE_QUEUE_HOURS=6
